rules_version = '2';
// Reglas de seguridad de Lunaya. Pégalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Correos de la dirección principal (los mismos de config.js)
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['lunatikatgroup@gmail.com', 'lunatikat.prestige@gmail.com'];
    }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function hasDoc() { return signedIn() && exists(memberPath(request.auth.uid)); }
    function meData() { return get(memberPath(request.auth.uid)).data; }
    function myRole() { return hasDoc() ? meData().role : ''; }
    function isAdmin() { return isOwnerEmail() || myRole() == 'admin'; }
    function isMember() { return isAdmin() || myRole() in ['tele', 'socio']; }
    function isLeader() { return myRole() == 'tele' && meData().get('lider', false) == true; }

    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    // Una invitación válida y sin usar que corresponde al rol que se está pidiendo
    function validInvite(data) {
      return data.get('inviteCode', '') is string
        && data.get('inviteCode', '').size() == 6
        && exists(invitePath(data.inviteCode))
        && get(invitePath(data.inviteCode)).data.status == 'enviada'
        && get(invitePath(data.inviteCode)).data.memberRole == data.role
        && data.get('lider', false) == false;
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMember());
      allow list: if isMember();
      allow create: if signedIn() && request.auth.uid == uid && (
            (isOwnerEmail() && request.resource.data.role == 'admin')
         || request.resource.data.role == 'pendiente'
         || validInvite(request.resource.data));
      allow update: if isAdmin()
         || (signedIn() && request.auth.uid == uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email', 'photo']))
         || (signedIn() && request.auth.uid == uid && resource.data.role == 'pendiente'
             && (request.resource.data.role == 'pendiente' || validInvite(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin() || isLeader();
      allow create: if request.resource.data.status == 'enviada'
         && request.resource.data.invitedBy == request.auth.uid
         && (isAdmin() || (isLeader() && request.resource.data.memberRole != 'admin'));
      allow update: if isAdmin()
         || (signedIn() && resource.data.status == 'enviada'
             && request.resource.data.status == 'aceptada'
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'uid']));
      allow delete: if isAdmin() || (isLeader() && resource.data.invitedBy == request.auth.uid);
    }

    match /appts/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.teleId == request.auth.uid;
      allow update: if isAdmin()
         || (isMember() && (resource.data.socioId == request.auth.uid || resource.data.teleId == request.auth.uid));
      allow delete: if isAdmin() || (isMember() && resource.data.teleId == request.auth.uid);
    }

    // Registro diario de llamadas: cada persona escribe solo el suyo (id = fecha_uid)
    match /calllog/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
         && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$')
         && request.resource.data.teleId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Enlace al Drive de cada socio: solo lo ven el socio dueño y las telemarketers
    match /drives/{socioId} {
      allow read: if signedIn() && (request.auth.uid == socioId || myRole() == 'tele');
      allow write: if signedIn() && request.auth.uid == socioId
         && request.resource.data.url is string
         && request.resource.data.url.matches('^https://(drive|docs)[.]google[.]com/.*');
    }

    match /config/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
