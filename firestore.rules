rules_version = '2';
// Reglas de seguridad de Lunaya. Pégalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Correos de la dirección principal (los mismos de config.js)
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['lunatikatgroup@gmail.com'];
    }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function hasDoc() { return signedIn() && exists(memberPath(request.auth.uid)); }
    function meData() { return get(memberPath(request.auth.uid)).data; }
    // Quien tiene el acceso suspendido (bloqueado) se trata como sin rol: no puede leer ni escribir hasta que Dirección se lo devuelva
    // sinTele (lo pone solo la dueña) quita el telemarketing sin borrar a la persona.
    // Si el campo no existe, sigue con telemarketing, como hasta ahora. La dueña nunca queda sin él.
    function myRole() {
      return !hasDoc() ? ''
        : (('bloqueado' in meData()) && meData().role != 'admin') ? 'bloqueado'
        : (meData().get('sinTele', false) == true && !isOwnerEmail()) ? 'cobranza'
        : meData().role;
    }
    function isAdmin() { return isOwnerEmail() || myRole() == 'admin'; }
    // ===== Bots (asistentes de IA de Katerine) =====
    // Un solo usuario (correo y contraseña) con rol 'bot'. Solo la dueña (isOwnerEmail) se lo asigna desde Equipo.
    // 'jefe' = uid de la dueña: el bot ve y trabaja los clientes, citas y prospectos de ella como si fuera Dirección.
    // NO puede: borrar nada, cambiar roles, suspender o quitar gente, crear invitaciones ni cambiar la configuración.
    // Si se le suspende el acceso (bloqueado), queda sin rol como cualquiera.
    function isBot() { return myRole() == 'bot'; }
    function jefeBot() { return meData().get('jefe', ''); }
    function botVe(d) { return isBot() && jefeBot() != '' && (d.get('socioId', '') == jefeBot() || d.get('up', '') == jefeBot()
      || d.get('teleId', '') == jefeBot() || d.get('by', '') == jefeBot() || d.get('dador', '') == jefeBot()
      || d.get('dueno', '') == jefeBot() || d.get('fam', '') == jefeBot()); }
    // Dirección o el bot: para leer y guardar (nunca para borrar ni para manejar personas)
    function isStaff() { return isAdmin() || isBot(); }
    function isMember() { return isAdmin() || myRole() in ['tele', 'socio', 'bot']; }
    function isLeader() { return myRole() == 'tele' && meData().get('lider', false) == true; }
    // Distribuidor: maneja su propio grupo (emprendedores y telemarketers que él invita)
    // Telemarketer del programa Lunaya (no externa de un distribuidor)
    function isProgramTele() { return myRole() == 'tele' && meData().get('upline', '') == ''; }
    // Asistente de pagos de Katerine: una telemarketer marcada por Dirección
    function isAsist() { return myRole() in ['tele', 'socio'] && meData().get('asistente', false) == true; }
    function isDist() { return myRole() == 'socio' && meData().get('tipo', '') == 'Socio distribuidor'; }
    // Las telemarketers del programa entran solas al mundo de cada distribuidor, menos las que él (o Dirección) quitó (teleNo)
    function distOk(d) { return d is string && d != '' && get(memberPath(d)).data.get('tipo', '') == 'Socio distribuidor'
      && !(request.auth.uid in get(memberPath(d)).data.get('teleNo', [])); }
    // Telemarketer del programa Lunaya (por uid) y la líder que maneja sus citas
    function progTele(uid) { return uid is string && uid != '' && get(memberPath(uid)).data.role in ['tele', 'baja']
      && get(memberPath(uid)).data.get('upline', '') == ''; }
    function liderDe(data) { return isLeader() && meData().get('upline', '') == '' && progTele(data.teleId); }
    function teleApptOk(sid) { return tvDe(sid) || distOk(sid) || distOk(get(memberPath(sid)).data.get('upline', '')); }
    // Las telemarketers trabajan en equipo: las del programa ven todo el mundo de cada distribuidor que no las quitó,
    // y las externas de un distribuidor ven todo el mundo de su distribuidor
    function teleDistDe(data) { return (isProgramTele() && (distOk(data.socioId) || distOk(data.get('up', ''))))
      || (myRole() == 'tele' && meData().get('upline', '') != '' && (data.socioId == meData().upline || data.get('up', '') == meData().upline)); }

    // Socio que Dirección autoriza a ver los links y prospectos de otro (ej. Andrés ve los de Katerine): solo lectura
    function veDe(d) { return isMember() && meData().get('verDe', '') != '' && d.socioId == meData().get('verDe', ''); }

    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    // Una invitación válida y sin usar que corresponde al rol que se está pidiendo
    function validInvite(data) {
      return data.get('inviteCode', '') is string
        && data.get('inviteCode', '').size() == 6
        && data.role != 'bot'
        && exists(invitePath(data.inviteCode))
        && get(invitePath(data.inviteCode)).data.status == 'enviada'
        && get(invitePath(data.inviteCode)).data.memberRole == data.role
        && data.get('upline', '') == get(invitePath(data.inviteCode)).data.get('upline', '')
        && data.get('lider', false) == false
        && data.get('aporte', -1) == get(invitePath(data.inviteCode)).data.get('aporte', -1)
        && data.get('startDate', '') == get(invitePath(data.inviteCode)).data.get('startDate', '');
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMember());
      allow list: if isMember();
      allow create: if signedIn() && request.auth.uid == uid && (
            (isOwnerEmail() && request.resource.data.role == 'admin')
         || request.resource.data.role == 'pendiente'
         || validInvite(request.resource.data));
      allow update: if (isAdmin() && (isOwnerEmail()
             || (request.resource.data.get('role', '') != 'bot' && resource.data.get('role', '') != 'bot'
                 && request.resource.data.get('sinTele', false) == resource.data.get('sinTele', false))))
         // El distribuidor ajusta el plan de pago de SUS telemarketers
         || (isDist() && resource.data.get('upline', '') == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sueldo', 'pct', 'startDate', 'ruta']))
         // La líder saca del equipo a una telemarketer del programa (queda como baja, no se borra nada) o la devuelve
         || (isLeader() && resource.data.get('upline', '') == '' && request.auth.uid != uid
             && ((resource.data.role == 'tele' && resource.data.get('lider', false) == false && request.resource.data.role == 'baja'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'prevRole', 'lider', 'leftAt', 'leftBy']))
              || (resource.data.role == 'baja' && resource.data.get('prevRole', '') == 'tele' && request.resource.data.role == 'tele'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'leftAt']))))
         // La líder corrige el día en que empezó cada telemarketer del programa (para el sueldo)
         || (isLeader() && resource.data.role == 'tele' && resource.data.get('upline', '') == ''
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate']))
         || (signedIn() && request.auth.uid == uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email', 'photo', 'gcalId', 'planEmp', 'planTele', 'teleNo', 'metas', 'lastBackup', 'distNombre', 'cumple', 'ultimo']))
         || (signedIn() && request.auth.uid == uid && resource.data.role == 'pendiente'
             && (request.resource.data.role == 'pendiente' || validInvite(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isStaff() || isLeader() || (isDist() && resource.data.invitedBy == request.auth.uid);
      allow create: if request.resource.data.status == 'enviada'
         && request.resource.data.invitedBy == request.auth.uid
         && ((isAdmin() && (request.resource.data.get('upline', '') == '' || (request.resource.data.role == 'emprendedor' && request.resource.data.upline == request.auth.uid)))
             || (isLeader() && request.resource.data.memberRole != 'admin' && request.resource.data.get('upline', '') == '')
             || (isDist() && request.resource.data.role in ['emprendedor', 'tele']
                 && request.resource.data.upline == request.auth.uid));
      allow update: if isAdmin()
         // Quien invitó corrige los datos mientras no se haya aceptado
         || ((isLeader() || isDist()) && resource.data.invitedBy == request.auth.uid && resource.data.status == 'enviada'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'startDate']))
         || (signedIn() && resource.data.status == 'enviada'
             && request.resource.data.status == 'aceptada'
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'uid']));
      allow delete: if isAdmin() || ((isLeader() || isDist()) && resource.data.invitedBy == request.auth.uid);
    }

    function noClientData() { return !request.resource.data.keys().hasAny(['client', 'phone', 'city', 'address', 'notes', 'chat', 'seen']); }
    match /appts/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.teleId == request.auth.uid && noClientData();
      allow update: if noClientData() && (isStaff()
         || (isMember() && (resource.data.socioId == request.auth.uid || resource.data.teleId == request.auth.uid))
         // Las telemarketers del programa pueden pasar la cita de un socio a otro (ayudan cuando los socios están ocupados)
         || (isProgramTele() && teleApptOk(resource.data.socioId) && request.resource.data.teleId == resource.data.teleId
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['socioId', 'transferredFrom', 'transferredAt', 'transferredBy', 'transferReq', 'dueno']))
         // La cita que no se pudo hacer regresa a quien la dio (solo puede devolvérsela a sí mismo)
         || (isMember() && request.resource.data.socioId == request.auth.uid
             && (resource.data.get('transferredFrom', '') == request.auth.uid || resource.data.get('agendo', '') == request.auth.uid))
         || (isDist() && get(memberPath(resource.data.socioId)).data.get('upline', '') == request.auth.uid)
         // Telemarketers del programa: reportan el resultado (venta, no venta, seguimiento) y reprograman las citas
         // de los socios a los que tienen acceso (territorio de Dirección o distribuidor que no las quitó). No aprueban ventas.
         || (isProgramTele() && teleApptOk(resource.data.socioId)
             && request.resource.data.socioId == resource.data.socioId && request.resource.data.teleId == resource.data.teleId
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sale', 'amount', 'saleStatus', 'resultAt', 'resultBy', 'segWhen', 'refsDemo', 'acomp', 'entrenador', 'when', 'pasoPor', 'nomVenta', 'pendCall', 'saleLog', 'saleStatusAt', 'saleStatusBy', 'vent'])
             && request.resource.data.get('saleStatus', 'pendiente') in [resource.data.get('saleStatus', 'pendiente'), 'pendiente'])
         // La líder maneja completas las citas que sacaron las telemarketers del programa
         || (liderDe(resource.data) && request.resource.data.socioId == resource.data.socioId && request.resource.data.teleId == resource.data.teleId && noClientData())
         // El patrocinador aprueba (o no) que le pasen una cita a su emprendedor
         || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transferReq'])
             && resource.data.get('transferReq', {}).get('sponsor', '') == request.auth.uid
             && request.resource.data.transferReq.sponsor == request.auth.uid
             && request.resource.data.transferReq.to == resource.data.transferReq.to
             && request.resource.data.transferReq.by == resource.data.transferReq.by)
         // La líder de telemarketing puede aprobar o cancelar ventas (solo el estado de la venta)
         || (isLeader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleStatus', 'saleStatusAt', 'saleStatusBy', 'saleLog'])));
      allow delete: if isAdmin() || (isMember() && resource.data.teleId == request.auth.uid) || liderDe(resource.data);
    }

    // Datos privados de cada cita (cliente, teléfono, dirección, notas y mensajes).
    // Solo los ven el socio de la cita y la telemarketer que la agendó.
    // Cada director (Dirección) ve solo los de sus propios emprendedores (up == su uid); nunca los de
    // distribuidores ni de otro director. El distribuidor ve los de su grupo (up == su uid).
    // Historial de cada cliente por teléfono, dentro de un territorio (fam = director o distribuidor).
    // Lo ven las telemarketers, el dueño del territorio y los socios de su grupo.
    match /hist/{id} {
      allow read: if isMember() && (resource == null || myRole() == 'tele'
         || resource.data.fam == request.auth.uid || meData().get('upline', '') == resource.data.fam)
         || botVe(resource.data);
      allow create, update: if isMember()
         && request.resource.data.keys().hasOnly(['fam', 'tel', 'name', 'v'])
         && id == request.resource.data.fam + '_' + request.resource.data.tel;
      allow delete: if isAdmin();
    }

    match /apptp/{id} {
      // Involucrados: el socio de la cita, quien la agendó y quien se la dio (transfirió) a otro
      function involved() { return signedIn() && (resource.data.socioId == request.auth.uid || resource.data.teleId == request.auth.uid || resource.data.get('dador', '') == request.auth.uid || resource.data.get('dueno', '') == request.auth.uid); }
      function upline() { return signedIn() && resource.data.get('up', '') != '' && resource.data.get('up', '') == request.auth.uid; }
      function socioDoc() { return get(memberPath(request.resource.data.socioId)).data; }
      // tv = cita del territorio de Dirección: las telemarketers del programa la ven completa para darle seguimiento
      function teleVe() { return isProgramTele() && resource.data.get('tv', false) == true; }
      allow read: if involved() || upline() || teleVe() || teleDistDe(resource.data) || liderDe(resource.data) || botVe(resource.data);
      allow create: if isMember() && request.resource.data.teleId == request.auth.uid
         && request.resource.data.dir == (socioDoc().get('tipo', '') != 'Socio distribuidor' && socioDoc().get('upline', '') == '')
         && request.resource.data.get('up', '') == socioDoc().get('upline', '');
      // Cambios normales: no se toca a quién pertenece la cita.
      // Transferencia: la hace el socio dueño, su distribuidor o Dirección; la privacidad se recalcula para el nuevo socio.
      allow update: if ((involved() || upline() || botVe(resource.data))
         && request.resource.data.teleId == resource.data.teleId
         && ((request.resource.data.socioId == resource.data.socioId
              && request.resource.data.dir == resource.data.dir
              && request.resource.data.get('up', '') == resource.data.get('up', '')
              && (request.resource.data.get('tv', false) == resource.data.get('tv', false) || !('tv' in resource.data)))
          || (request.resource.data.socioId != resource.data.socioId
              && (resource.data.socioId == request.auth.uid || upline() || isStaff()
                  || (request.resource.data.socioId == request.auth.uid && (resource.data.get('dador', '') == request.auth.uid || resource.data.teleId == request.auth.uid)))
              && request.resource.data.dir == (socioDoc().get('tipo', '') != 'Socio distribuidor' && socioDoc().get('upline', '') == '')
              && request.resource.data.get('up', '') == socioDoc().get('upline', ''))))
         // Las telemarketers del programa pasan la cita de un socio a otro (la privacidad se recalcula para el nuevo socio)
         || (isProgramTele() && (teleVe() || teleDistDe(resource.data) || resource.data.teleId == request.auth.uid)
             && request.resource.data.teleId == resource.data.teleId
             && request.resource.data.socioId != resource.data.socioId
             && request.resource.data.dir == (socioDoc().get('tipo', '') != 'Socio distribuidor' && socioDoc().get('upline', '') == '')
             && request.resource.data.get('up', '') == socioDoc().get('upline', ''))
         // Separar Dirección: un director pasa a ver las citas de sus emprendedores (up = su grupo)
         || (isAdmin() && resource.data.get('up', '') == ''
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'dir'])
             && request.resource.data.up == request.auth.uid
             && socioDoc().get('upline', '') == request.auth.uid
             && request.resource.data.dir == false)
         // Cambio de grupo del emprendedor: Dirección o su director anterior pasan sus citas al grupo nuevo (solo up, dir y tv, con los valores correctos)
         || ((isAdmin() || upline()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'dir', 'tv'])
             && request.resource.data.get('up', '') == get(memberPath(resource.data.socioId)).data.get('upline', '')
             && request.resource.data.dir == (get(memberPath(resource.data.socioId)).data.get('tipo', '') != 'Socio distribuidor' && get(memberPath(resource.data.socioId)).data.get('upline', '') == '')
             && request.resource.data.tv == tvDe(resource.data.socioId))
         // La líder corrige los datos del cliente y escribe en las citas de sus telemarketers
         || (liderDe(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client', 'phone', 'city', 'address', 'notes', 'chat', 'seen', 'resNote']))
         // Corregir tv (territorio de Dirección) cuando quedó mal: solo se acepta el valor correcto según el socio de la cita
         || ((involved() || upline() || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tv'])
             && request.resource.data.tv == tvDe(resource.data.socioId))
         // Las telemarketers del programa pueden escribir en el chat de esas citas
         || ((teleVe() || teleDistDe(resource.data)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat', 'seen', 'resNote']));
      allow delete: if isAdmin() || (signedIn() && resource.data.teleId == request.auth.uid) || liderDe(resource.data);
    }

    // Registro diario de llamadas: cada persona escribe solo el suyo (id = fecha_uid)
    match /calllog/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
         && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$')
         && request.resource.data.teleId == request.auth.uid;
      // Dirección y la líder corrigen el tipo de los referidos (nuevos o viejos) que anotó cualquier telemarketer
      allow update: if (isStaff() || isLeader())
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refs'])
         && request.resource.data.refs.size() == resource.data.refs.size();
      allow delete: if isAdmin();
    }

    // Enlace al Drive de cada socio: lo ven y lo ponen el socio dueño y las telemarketers
    match /drives/{socioId} {
      allow read: if signedIn() && (request.auth.uid == socioId || myRole() == 'tele' || isBot());
      allow write: if signedIn() && (request.auth.uid == socioId || myRole() == 'tele')
         && request.resource.data.keys().hasOnly(['url', 'updatedAt', 'by'])
         && request.resource.data.url is string
         && request.resource.data.url.matches('^https://(drive|docs)[.]google[.]com/.*');
    }

    // ===== Ruleta / caja sorpresa (programa de referidos) =====
    // Territorio de un socio: tv = Dirección (lo trabajan las telemarketers del programa)
    function tvDe(sid) {
      let s = get(memberPath(sid)).data;
      return s.role == 'admin' || (s.get('tipo', '') != 'Socio distribuidor'
        && (s.get('upline', '') == '' || get(memberPath(s.upline)).data.role == 'admin'));
    }
    function juegoPath(code) { return /databases/$(database)/documents/juegos/$(code); }
    function leadPath(id) { return /databases/$(database)/documents/leads/$(id); }

    // Programas: regalos, fotos y probabilidades. Los ve cualquiera que abra un link (no tienen datos de clientes).
    match /programs/{pid} {
      allow get: if true;
      allow list: if isMember();
      allow create: if isMember() && request.resource.data.owner == request.auth.uid;
      allow update: if isMember() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if isMember() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Links: público solo el nombre que se muestra y el contador de amigas
    match /juegos/{code} {
      function lv() { return isMember() && (resource.data.by == request.auth.uid || resource.data.socioId == request.auth.uid
        || resource.data.get('up', '') == request.auth.uid || (isProgramTele() && resource.data.get('tv', false) == true) || teleDistDe(resource.data)
        || botVe(resource.data)); }
      allow get: if true;
      allow list: if lv() || veDe(resource.data);
      // Un socio o telemarketer inscribe a un cliente o crea una campaña
      allow create: if isMember() && request.resource.data.by == request.auth.uid
         && request.resource.data.n == 0 && request.resource.data.kind in ['cliente', 'campana']
         && request.resource.data.up == get(memberPath(request.resource.data.socioId)).data.get('upline', '')
         && request.resource.data.tv == tvDe(request.resource.data.socioId)
         && request.resource.data.until <= request.time.toMillis() + 61 * 86400000;
      // La amiga que ya participó invita a las suyas: su link copia el de quien la invitó
      allow create: if request.resource.data.kind == 'amiga' && request.resource.data.n == 0
         && request.resource.data.keys().hasOnly(['pid', 'ref', 'socioId', 'up', 'tv', 'by', 'n', 'until', 'padre', 'refLead', 'createdAt', 'kind', 'meta', 'tipo'])
         && request.resource.data.ref is string && request.resource.data.ref.size() <= 61
         && request.resource.data.refLead.matches('^' + request.resource.data.padre + '_[0-9]{10}$')
         && exists(leadPath(request.resource.data.refLead))
         && get(juegoPath(request.resource.data.padre)).data.pid == request.resource.data.pid
         && get(juegoPath(request.resource.data.padre)).data.socioId == request.resource.data.socioId
         && get(juegoPath(request.resource.data.padre)).data.get('up', '') == request.resource.data.up
         && get(juegoPath(request.resource.data.padre)).data.get('tv', false) == request.resource.data.tv
         && get(juegoPath(request.resource.data.padre)).data.by == request.resource.data.by
         && request.resource.data.until <= request.time.toMillis() + 15 * 86400000;
      // Cada amiga que participa suma 1, junto con su registro
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'last'])
         && request.resource.data.n == resource.data.get('n', 0) + 1
         && request.resource.data.last.matches('^' + code + '_[0-9]{10}$')
         && existsAfter(leadPath(request.resource.data.last)) && !exists(leadPath(request.resource.data.last));
      allow update: if lv() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['until', 'ref', 'alias', 'regalos', 'visitas', 'ganados', 'avisados', 'img'])
         && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 700000));
      // Anuncios: cuenta cuántos entraron y cuántos jugaron (de uno en uno)
      allow update: if resource.data.get('anuncio', false) == true
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vis'])
         && request.resource.data.vis == resource.data.get('vis', 0) + 1;
      allow update: if resource.data.get('anuncio', false) == true
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jug'])
         && request.resource.data.jug == resource.data.get('jug', 0) + 1;
      allow delete: if isMember() && (resource.data.by == request.auth.uid || resource.data.socioId == request.auth.uid);
    }

    // Prospectos de la ruleta: los ven el socio, quien creó el link, su director o distribuidor
    // y, en el territorio de Dirección, las telemarketers del programa.
    match /leads/{id} {
      function lv() { return signedIn() && (resource.data.socioId == request.auth.uid || resource.data.by == request.auth.uid
        || resource.data.get('up', '') == request.auth.uid || (isProgramTele() && resource.data.get('tv', false) == true) || teleDistDe(resource.data)
        || botVe(resource.data)); }
      allow read: if lv() || veDe(resource.data);
      // La amiga que juega (sin cuenta): teléfono completo de 10 dígitos, un registro por número y por link
      allow create: if request.resource.data.keys().hasOnly(['code', 'pid', 'name', 'tel', 'prize', 'at', 'socioId', 'up', 'tv', 'by', 'ref', 'status', 'kind', 'acepta', 'quiz'])
         && (!('quiz' in request.resource.data) || (request.resource.data.quiz is string && request.resource.data.quiz.size() <= 120))
         && request.resource.data.kind == 'jugador' && request.resource.data.status == 'nuevo' && request.resource.data.acepta == true
         && request.resource.data.tel is string && request.resource.data.tel.matches('^[2-9][0-9]{9}$')
         && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
         && request.resource.data.prize is string && request.resource.data.prize.size() <= 80
         && id == request.resource.data.code + '_' + request.resource.data.tel
         && get(juegoPath(request.resource.data.code)).data.pid == request.resource.data.pid
         && get(juegoPath(request.resource.data.code)).data.socioId == request.resource.data.socioId
         && get(juegoPath(request.resource.data.code)).data.get('up', '') == request.resource.data.up
         && get(juegoPath(request.resource.data.code)).data.get('tv', false) == request.resource.data.tv
         && get(juegoPath(request.resource.data.code)).data.by == request.resource.data.by
         && get(juegoPath(request.resource.data.code)).data.ref == request.resource.data.ref
         && (get(juegoPath(request.resource.data.code)).data.until == 0 || get(juegoPath(request.resource.data.code)).data.until > request.time.toMillis())
         && getAfter(juegoPath(request.resource.data.code)).data.n == get(juegoPath(request.resource.data.code)).data.get('n', 0) + 1;
      // Contactos de la hoja del cliente (los pasa el socio o la telemarketer): quedan con los mismos datos del link
      allow create: if isMember() && request.resource.data.kind == 'hoja' && request.resource.data.status == 'nuevo'
         && request.resource.data.tel is string && request.resource.data.tel.matches('^[2-9][0-9]{9}$')
         && id == request.resource.data.code + '_h_' + request.resource.data.tel
         && get(juegoPath(request.resource.data.code)).data.pid == request.resource.data.pid
         && get(juegoPath(request.resource.data.code)).data.socioId == request.resource.data.socioId
         && get(juegoPath(request.resource.data.code)).data.get('up', '') == request.resource.data.up
         && get(juegoPath(request.resource.data.code)).data.get('tv', false) == request.resource.data.tv
         && get(juegoPath(request.resource.data.code)).data.by == request.resource.data.by
         && (request.resource.data.by == request.auth.uid || request.resource.data.socioId == request.auth.uid || request.resource.data.up == request.auth.uid
             || (isProgramTele() && request.resource.data.tv == true) || teleDistDe(request.resource.data) || botVe(request.resource.data));
      // El cliente que refiere (o la lista de una campaña): lo guarda quien crea el link
      allow create: if isMember() && request.resource.data.by == request.auth.uid && request.resource.data.kind == 'ref'
         && id == request.resource.data.code + '_ref'
         && getAfter(juegoPath(request.resource.data.code)).data.by == request.auth.uid;
      allow update: if lv() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'notes', 'apptId', 'lista', 'enviado', 'foto', 'intentos']);
      // Corregir el nombre o el teléfono del cliente dueño del link
      allow update: if lv() && resource.data.kind == 'ref' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'ref', 'tel', 'dir', 'ciudad', 'notas']);
      allow delete: if lv() && (resource.data.by == request.auth.uid || resource.data.socioId == request.auth.uid || isAdmin());
    }

    // Anuncios de Meta que crea cada persona con su propia cuenta (aquí solo se guarda el registro y los resultados)
    match /anuncios/{id} {
      allow read: if isStaff() || (isMember() && resource.data.owner == request.auth.uid);
      allow create: if isMember() && request.resource.data.owner == request.auth.uid;
      allow update: if isMember() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if isMember() && resource.data.owner == request.auth.uid;
    }

    // Pagos de los distribuidores a Lunaya: el distribuidor marca que pagó, Dirección lo confirma
    match /pagosdist/{id} {
      allow read: if isStaff() || isAsist() || (isMember() && resource.data.payer == request.auth.uid);
      allow create: if isMember() && request.resource.data.payer == request.auth.uid && id.matches('^' + request.auth.uid + '_.*')
         && request.resource.data.ok == false;
      // Katerine registra el pago (el distribuidor solo lo ve)
      allow create: if isStaff() || isAsist();
      allow update: if isStaff() || isAsist();
      allow delete: if isAdmin();
    }

    // Recordatorios de llamada: cada quien ve y maneja solo los suyos
    match /recordatorios/{id} {
      allow read, update, delete: if isMember() && resource.data.owner == request.auth.uid;
      allow create: if isMember() && request.resource.data.owner == request.auth.uid;
    }

    // En vivo: en qué base (socio) está trabajando cada telemarketer
    match /presencia/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['socio', 'at', 'name'])
         && request.resource.data.socio is string && request.resource.data.socio.size() <= 64;
    }

    match /config/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ===== Reclutamiento (página aparte: /reclutamiento) =====
    // Entra la dueña y las personas que ella agrega por correo en rconfig/main.staff
    function rStaff() {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/rconfig/main)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/rconfig/main).data.get('staff', {});
    }
    function rDir() {
      return isOwnerEmail() || (rStaff() && 'direccion' in get(/databases/$(database)/documents/rconfig/main).data.staff[request.auth.token.email.lower()].get('roles', []));
    }
    match /rconfig/{id} {
      allow read: if signedIn();
      allow write: if rDir();
    }
    match /rcands/{id} {
      allow read, create, update: if isOwnerEmail() || rStaff();
      allow delete: if rDir();
    }

    // ===== Cobranza y postventa (página aparte: /cobranza) =====
    // Entra la dueña, el usuario bot (crear y actualizar, nunca borrar) y las personas
    // que ella agrega por correo en cconfig/main.staff.
    // Tarjetas en archivo (ctarjetas): las ve la dueña y los uid que ella marcó en
    // cconfig/main.tarjetas («Pueden ver tarjetas»). El bot nunca, aunque su uid esté en la lista.
    // No se guarda el CVV. Estas reglas se pegan a mano en Firebase; la app no las publica.
    function cStaff() {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/cconfig/main)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/cconfig/main).data.get('staff', {});
    }
    function cAccess() { return isOwnerEmail() || cStaff() || isBot(); }
    function cTarjetaOk() {
      return isOwnerEmail() || (signedIn() && !isBot()
        && exists(/databases/$(database)/documents/cconfig/main)
        && request.auth.uid in get(/databases/$(database)/documents/cconfig/main).data.get('tarjetas', []));
    }
    function ccliPath(cid) { return /databases/$(database)/documents/ccli/$(cid); }
    function noSecrets() {
      return !request.resource.data.keys().hasAny(['cvv', 'cvc', 'cvv2', 'cid', 'securityCode', 'numero', 'pan', 'tarjeta', 'cardNumber']);
    }
    function noCvv() {
      return !request.resource.data.keys().hasAny(['cvv', 'cvc', 'cvv2', 'cid', 'securityCode']);
    }
    function clienteExiste(cid) { return exists(ccliPath(cid)); }
    function mismoAutor() {
      return request.resource.data.by is string
        && (resource == null
          ? request.resource.data.by == request.auth.token.email.lower()
          : request.resource.data.by == resource.data.by);
    }
    function actOk(cid) {
      return noSecrets()
        && exists(ccliPath(cid))
        && request.resource.data.keys().hasOnly(['by', 'quien', 'byName', 'at', 'tipo', 'resultado', 'mensaje', 'promesaFecha', 'promesaMonto', 'clientId'])
        && request.resource.data.by == request.auth.token.email.lower()
        && request.resource.data.tipo in ['llamada', 'whatsapp', 'sms', 'correo', 'nota']
        && request.resource.data.resultado in ['contesto', 'no', 'buzon', 'promesa', 'pago', 'equivocado', '']
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 2000
        && request.resource.data.clientId == cid
        && request.resource.data.at is number
        && (!('quien' in request.resource.data) || (request.resource.data.quien is string && request.resource.data.quien.size() <= 80))
        && (!('byName' in request.resource.data) || (request.resource.data.byName is string && request.resource.data.byName.size() <= 80))
        && (!('promesaFecha' in request.resource.data) || (request.resource.data.promesaFecha is string && request.resource.data.promesaFecha.size() <= 20))
        && (!('promesaMonto' in request.resource.data) || request.resource.data.promesaMonto is number);
    }
    function pagoOk() {
      return noSecrets()
        && request.resource.data.keys().hasOnly(['clientId', 'nombre', 'fecha', 'at', 'monto', 'metodo', 'by', 'nota', 'quien'])
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() > 0
        && request.resource.data.clientId.size() <= 80
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() <= 20
        && request.resource.data.at is number
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.metodo in ['cheque', 'sitio', 'llamada', 'tarjeta', 'link', 'otro']
        && request.resource.data.by == request.auth.token.email.lower()
        && request.resource.data.nota is string
        && request.resource.data.nota.size() <= 800
        && (!('quien' in request.resource.data) || (request.resource.data.quien is string && request.resource.data.quien.size() <= 80))
        && clienteExiste(request.resource.data.clientId);
    }
    function postOk() {
      return noSecrets()
        && request.resource.data.keys().hasOnly(['clientId', 'nombre', 'tel', 'email', 'producto', 'pedido', 'carrier', 'tracking', 'entrega', 'entregado', 'recibio', 'recibioAt', 'recibioBy', 'autopay', 'autopayFecha', 'autopayMetodo', 'notas', 'createdAt', 'updatedAt', 'lastSyncAt', 'syncedBy', 'by'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.notas is string
        && request.resource.data.notas.size() <= 2000
        && request.resource.data.entregado is bool
        && request.resource.data.recibio is bool
        && request.resource.data.autopay is bool
        && request.resource.data.autopayMetodo in ['', 'cheque', 'sitio', 'llamada', 'tarjeta']
        && (!('clientId' in request.resource.data) || (request.resource.data.clientId is string && request.resource.data.clientId.size() <= 80))
        && (!('tracking' in request.resource.data) || (request.resource.data.tracking is string && request.resource.data.tracking.size() <= 80))
        && (!('carrier' in request.resource.data) || (request.resource.data.carrier is string && request.resource.data.carrier.size() <= 40))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
        && (!('tel' in request.resource.data) || (request.resource.data.tel is string && request.resource.data.tel.size() <= 30))
        && (!('producto' in request.resource.data) || (request.resource.data.producto is string && request.resource.data.producto.size() <= 160))
        && (!('entrega' in request.resource.data) || (request.resource.data.entrega is string && request.resource.data.entrega.size() <= 20))
        && (!('recibioBy' in request.resource.data) || (request.resource.data.recibioBy is string && request.resource.data.recibioBy.size() <= 80))
        && mismoAutor();
    }
    function linkOk() {
      return noSecrets()
        && request.resource.data.keys().hasOnly(['clientId', 'nombre', 'status', 'url', 'askedBy', 'askedAt', 'filledBy', 'filledAt', 'nota'])
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() > 0
        && request.resource.data.nombre is string
        && request.resource.data.status in ['pendiente', 'lista']
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('^https://.+'))
        && request.resource.data.askedBy is string
        && request.resource.data.nota is string
        && request.resource.data.nota.size() <= 500
        && request.resource.data.askedAt is number
        && (!('filledBy' in request.resource.data) || request.resource.data.filledBy is string)
        && (!('filledAt' in request.resource.data) || request.resource.data.filledAt is number)
        && (request.resource.data.status != 'lista' || (request.resource.data.url.matches('^https://.+') && request.resource.data.filledBy == request.auth.token.email.lower()))
        && clienteExiste(request.resource.data.clientId)
        && (resource == null
          ? (request.resource.data.status == 'pendiente' && request.resource.data.askedBy == request.auth.token.email.lower())
          : request.resource.data.askedBy == resource.data.askedBy);
    }
    function tarjetaOk() {
      return noCvv()
        && request.resource.data.keys().hasOnly(['clientId', 'cliente', 'titular', 'numero', 'exp', 'zip', 'notas', 'updatedAt', 'by'])
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() <= 80
        && request.resource.data.cliente is string
        && request.resource.data.cliente.size() <= 120
        && request.resource.data.titular is string
        && request.resource.data.titular.size() > 0
        && request.resource.data.titular.size() <= 80
        && request.resource.data.numero is string
        && request.resource.data.numero.matches('^[0-9]{13,19}$')
        && request.resource.data.exp is string
        && request.resource.data.exp.matches('^(0[1-9]|1[0-2])/[0-9]{2}$')
        && request.resource.data.zip is string
        && request.resource.data.zip.matches('^[0-9A-Za-z \\-]{3,12}$')
        && request.resource.data.notas is string
        && request.resource.data.notas.size() <= 500
        && request.resource.data.updatedAt is number
        && mismoAutor();
    }
    match /cconfig/{id} {
      allow read: if signedIn();
      allow write: if isOwnerEmail();
    }
    match /ccli/{id} {
      allow read: if cAccess();
      allow create, update: if cAccess() && noSecrets() && request.resource.data.keys().size() < 80;
      allow delete: if isOwnerEmail();
      match /act/{aid} {
        allow read: if cAccess();
        allow create, update: if cAccess() && actOk(id);
        allow delete: if isOwnerEmail();
      }
    }
    // El tablero junta la actividad de todas las cuentas. Esa consulta solo engancha con esta ruta.
    match /{path=**}/act/{aid} {
      allow read: if cAccess();
    }
    match /cpagos/{id} {
      allow read: if cAccess();
      allow create, update: if cAccess() && pagoOk();
      allow delete: if isOwnerEmail();
    }
    match /cpost/{id} {
      allow read: if cAccess();
      allow create, update: if cAccess() && postOk();
      allow delete: if isOwnerEmail();
    }
    match /clinkreq/{id} {
      allow read: if cAccess();
      allow create, update: if cAccess() && linkOk();
      allow delete: if isOwnerEmail();
    }
    match /ctarjetas/{id} {
      allow read: if cTarjetaOk();
      allow create, update: if cTarjetaOk() && tarjetaOk();
      allow delete: if isOwnerEmail();
    }
  }
}