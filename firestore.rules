rules_version = '2';
// Reglas de seguridad de Lunaya. Pégalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Correos de la dirección principal (los mismos de config.js)
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['lunatikatgroup@gmail.com'];
    }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function hasDoc() { return signedIn() && exists(memberPath(request.auth.uid)); }
    function meData() { return get(memberPath(request.auth.uid)).data; }
    function myRole() { return hasDoc() ? meData().role : ''; }
    function isAdmin() { return isOwnerEmail() || myRole() == 'admin'; }
    function isMember() { return isAdmin() || myRole() in ['tele', 'socio']; }
    function isLeader() { return myRole() == 'tele' && meData().get('lider', false) == true; }
    // Distribuidor: maneja su propio grupo (emprendedores y telemarketers que él invita)
    function isDist() { return myRole() == 'socio' && meData().get('tipo', '') == 'Socio distribuidor'; }

    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    // Una invitación válida y sin usar que corresponde al rol que se está pidiendo
    function validInvite(data) {
      return data.get('inviteCode', '') is string
        && data.get('inviteCode', '').size() == 6
        && exists(invitePath(data.inviteCode))
        && get(invitePath(data.inviteCode)).data.status == 'enviada'
        && get(invitePath(data.inviteCode)).data.memberRole == data.role
        && data.get('upline', '') == get(invitePath(data.inviteCode)).data.get('upline', '')
        && data.get('lider', false) == false;
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMember());
      allow list: if isMember();
      allow create: if signedIn() && request.auth.uid == uid && (
            (isOwnerEmail() && request.resource.data.role == 'admin')
         || request.resource.data.role == 'pendiente'
         || validInvite(request.resource.data));
      allow update: if isAdmin()
         || (signedIn() && request.auth.uid == uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email', 'photo']))
         || (signedIn() && request.auth.uid == uid && resource.data.role == 'pendiente'
             && (request.resource.data.role == 'pendiente' || validInvite(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin() || isLeader() || (isDist() && resource.data.invitedBy == request.auth.uid);
      allow create: if request.resource.data.status == 'enviada'
         && request.resource.data.invitedBy == request.auth.uid
         && ((isAdmin() && (request.resource.data.get('upline', '') == '' || (request.resource.data.role == 'emprendedor' && request.resource.data.upline == request.auth.uid)))
             || (isLeader() && request.resource.data.memberRole != 'admin' && request.resource.data.get('upline', '') == '')
             || (isDist() && request.resource.data.role in ['emprendedor', 'tele']
                 && request.resource.data.upline == request.auth.uid));
      allow update: if isAdmin()
         || (signedIn() && resource.data.status == 'enviada'
             && request.resource.data.status == 'aceptada'
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'uid']));
      allow delete: if isAdmin() || ((isLeader() || isDist()) && resource.data.invitedBy == request.auth.uid);
    }

    function noClientData() { return !request.resource.data.keys().hasAny(['client', 'phone', 'city', 'address', 'notes', 'chat', 'seen']); }
    match /appts/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.teleId == request.auth.uid && noClientData();
      allow update: if noClientData() && (isAdmin()
         || (isMember() && (resource.data.socioId == request.auth.uid || resource.data.teleId == request.auth.uid))
         || (isDist() && get(memberPath(resource.data.socioId)).data.get('upline', '') == request.auth.uid));
      allow delete: if isAdmin() || (isMember() && resource.data.teleId == request.auth.uid);
    }

    // Datos privados de cada cita (cliente, teléfono, dirección, notas y mensajes).
    // Solo los ven el socio de la cita y la telemarketer que la agendó.
    // Cada director (Dirección) ve solo los de sus propios emprendedores (up == su uid); nunca los de
    // distribuidores ni de otro director. El distribuidor ve los de su grupo (up == su uid).
    match /apptp/{id} {
      function involved() { return signedIn() && (resource.data.socioId == request.auth.uid || resource.data.teleId == request.auth.uid); }
      function upline() { return signedIn() && resource.data.get('up', '') != '' && resource.data.get('up', '') == request.auth.uid; }
      function socioDoc() { return get(memberPath(request.resource.data.socioId)).data; }
      allow read: if involved() || upline();
      allow create: if isMember() && request.resource.data.teleId == request.auth.uid
         && request.resource.data.dir == (socioDoc().get('tipo', '') != 'Socio distribuidor' && socioDoc().get('upline', '') == '')
         && request.resource.data.get('up', '') == socioDoc().get('upline', '');
      // Cambios normales: no se toca a quién pertenece la cita.
      // Transferencia: la hace el socio dueño, su distribuidor o Dirección; la privacidad se recalcula para el nuevo socio.
      allow update: if ((involved() || upline())
         && request.resource.data.teleId == resource.data.teleId
         && ((request.resource.data.socioId == resource.data.socioId
              && request.resource.data.dir == resource.data.dir
              && request.resource.data.get('up', '') == resource.data.get('up', ''))
          || (request.resource.data.socioId != resource.data.socioId
              && (resource.data.socioId == request.auth.uid || upline() || isAdmin())
              && request.resource.data.dir == (socioDoc().get('tipo', '') != 'Socio distribuidor' && socioDoc().get('upline', '') == '')
              && request.resource.data.get('up', '') == socioDoc().get('upline', ''))))
         // Separar Dirección: un director pasa a ver las citas de sus emprendedores (up = su grupo)
         || (isAdmin() && resource.data.get('up', '') == ''
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'dir'])
             && request.resource.data.up == request.auth.uid
             && socioDoc().get('upline', '') == request.auth.uid
             && request.resource.data.dir == false);
      allow delete: if isAdmin() || (signedIn() && resource.data.teleId == request.auth.uid);
    }

    // Registro diario de llamadas: cada persona escribe solo el suyo (id = fecha_uid)
    match /calllog/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
         && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$')
         && request.resource.data.teleId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Enlace al Drive de cada socio: solo lo ven el socio dueño y las telemarketers
    match /drives/{socioId} {
      allow read: if signedIn() && (request.auth.uid == socioId || myRole() == 'tele');
      allow write: if signedIn() && request.auth.uid == socioId
         && request.resource.data.url is string
         && request.resource.data.url.matches('^https://(drive|docs)[.]google[.]com/.*');
    }

    match /config/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
