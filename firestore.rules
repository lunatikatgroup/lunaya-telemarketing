rules_version = '2';
// Reglas de seguridad de Lunaya. Pégalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Correos de la dirección principal (los mismos de config.js)
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['lunatikatgroup@gmail.com'];
    }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function hasDoc() { return signedIn() && exists(memberPath(request.auth.uid)); }
    function meData() { return get(memberPath(request.auth.uid)).data; }
    function myRole() { return hasDoc() ? meData().role : ''; }
    function isAdmin() { return isOwnerEmail() || myRole() == 'admin'; }
    function isMember() { return isAdmin() || myRole() in ['tele', 'socio']; }
    function isLeader() { return myRole() == 'tele' && meData().get('lider', false) == true; }
    // Distribuidor: maneja su propio grupo (emprendedores y telemarketers que él invita)
    // Telemarketer del programa Lunaya (no externa de un distribuidor)
    function isProgramTele() { return myRole() == 'tele' && meData().get('upline', '') == ''; }
    function isDist() { return myRole() == 'socio' && meData().get('tipo', '') == 'Socio distribuidor'; }
    // Las telemarketers del programa entran solas al mundo de cada distribuidor, menos las que él (o Dirección) quitó (teleNo)
    function distOk(d) { return d is string && d != '' && get(memberPath(d)).data.get('tipo', '') == 'Socio distribuidor'
      && !(request.auth.uid in get(memberPath(d)).data.get('teleNo', [])); }
    // Telemarketer del programa Lunaya (por uid) y la líder que maneja sus citas
    function progTele(uid) { return uid is string && uid != '' && get(memberPath(uid)).data.role in ['tele', 'baja']
      && get(memberPath(uid)).data.get('upline', '') == ''; }
    function liderDe(data) { return isLeader() && meData().get('upline', '') == '' && progTele(data.teleId); }
    function teleApptOk(sid) { return tvDe(sid) || distOk(sid) || distOk(get(memberPath(sid)).data.get('upline', '')); }
    function teleDistDe(data) { return isProgramTele() && (distOk(data.socioId) || distOk(data.get('up', ''))); }

    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    // Una invitación válida y sin usar que corresponde al rol que se está pidiendo
    function validInvite(data) {
      return data.get('inviteCode', '') is string
        && data.get('inviteCode', '').size() == 6
        && exists(invitePath(data.inviteCode))
        && get(invitePath(data.inviteCode)).data.status == 'enviada'
        && get(invitePath(data.inviteCode)).data.memberRole == data.role
        && data.get('upline', '') == get(invitePath(data.inviteCode)).data.get('upline', '')
        && data.get('lider', false) == false;
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMember());
      allow list: if isMember();
      allow create: if signedIn() && request.auth.uid == uid && (
            (isOwnerEmail() && request.resource.data.role == 'admin')
         || request.resource.data.role == 'pendiente'
         || validInvite(request.resource.data));
      allow update: if isAdmin()
         // El distribuidor ajusta el plan de pago de SUS telemarketers
         || (isDist() && resource.data.get('upline', '') == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sueldo', 'pct', 'startDate']))
         || (signedIn() && request.auth.uid == uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email', 'photo', 'gcalId', 'planEmp', 'planTele', 'teleNo']))
         || (signedIn() && request.auth.uid == uid && resource.data.role == 'pendiente'
             && (request.resource.data.role == 'pendiente' || validInvite(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin() || isLeader() || (isDist() && resource.data.invitedBy == request.auth.uid);
      allow create: if request.resource.data.status == 'enviada'
         && request.resource.data.invitedBy == request.auth.uid
         && ((isAdmin() && (request.resource.data.get('upline', '') == '' || (request.resource.data.role == 'emprendedor' && request.resource.data.upline == request.auth.uid)))
             || (isLeader() && request.resource.data.memberRole != 'admin' && request.resource.data.get('upline', '') == '')
             || (isDist() && request.resource.data.role in ['emprendedor', 'tele']
                 && request.resource.data.upline == request.auth.uid));
      allow update: if isAdmin()
         || (signedIn() && resource.data.status == 'enviada'
             && request.resource.data.status == 'aceptada'
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'uid']));
      allow delete: if isAdmin() || ((isLeader() || isDist()) && resource.data.invitedBy == request.auth.uid);
    }

    function noClientData() { return !request.resource.data.keys().hasAny(['client', 'phone', 'city', 'address', 'notes', 'chat', 'seen']); }
    match /appts/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.teleId == request.auth.uid && noClientData();
      allow update: if noClientData() && (isAdmin()
         || (isMember() && (resource.data.socioId == request.auth.uid || resource.data.teleId == request.auth.uid))
         || (isDist() && get(memberPath(resource.data.socioId)).data.get('upline', '') == request.auth.uid)
         // Telemarketers del programa: reportan el resultado (venta, no venta, seguimiento) y reprograman las citas
         // de los socios a los que tienen acceso (territorio de Dirección o distribuidor que no las quitó). No aprueban ventas.
         || (isProgramTele() && teleApptOk(resource.data.socioId)
             && request.resource.data.socioId == resource.data.socioId && request.resource.data.teleId == resource.data.teleId
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sale', 'amount', 'saleStatus', 'resultAt', 'resultBy', 'segWhen', 'refsDemo', 'acomp', 'entrenador', 'when'])
             && request.resource.data.get('saleStatus', 'pendiente') in [resource.data.get('saleStatus', 'pendiente'), 'pendiente'])
         // La líder maneja completas las citas que sacaron las telemarketers del programa
         || (liderDe(resource.data) && request.resource.data.socioId == resource.data.socioId && request.resource.data.teleId == resource.data.teleId && noClientData())
         // La líder de telemarketing puede aprobar o cancelar ventas (solo el estado de la venta)
         || (isLeader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleStatus', 'saleStatusAt', 'saleStatusBy'])));
      allow delete: if isAdmin() || (isMember() && resource.data.teleId == request.auth.uid) || liderDe(resource.data);
    }

    // Datos privados de cada cita (cliente, teléfono, dirección, notas y mensajes).
    // Solo los ven el socio de la cita y la telemarketer que la agendó.
    // Cada director (Dirección) ve solo los de sus propios emprendedores (up == su uid); nunca los de
    // distribuidores ni de otro director. El distribuidor ve los de su grupo (up == su uid).
    // Historial de cada cliente por teléfono, dentro de un territorio (fam = director o distribuidor).
    // Lo ven las telemarketers, el dueño del territorio y los socios de su grupo.
    match /hist/{id} {
      allow read: if isMember() && (resource == null || myRole() == 'tele'
         || resource.data.fam == request.auth.uid || meData().get('upline', '') == resource.data.fam);
      allow create, update: if isMember()
         && request.resource.data.keys().hasOnly(['fam', 'tel', 'name', 'v'])
         && id == request.resource.data.fam + '_' + request.resource.data.tel;
      allow delete: if isAdmin();
    }

    match /apptp/{id} {
      // Involucrados: el socio de la cita, quien la agendó y quien se la dio (transfirió) a otro
      function involved() { return signedIn() && (resource.data.socioId == request.auth.uid || resource.data.teleId == request.auth.uid || resource.data.get('dador', '') == request.auth.uid); }
      function upline() { return signedIn() && resource.data.get('up', '') != '' && resource.data.get('up', '') == request.auth.uid; }
      function socioDoc() { return get(memberPath(request.resource.data.socioId)).data; }
      // tv = cita del territorio de Dirección: las telemarketers del programa la ven completa para darle seguimiento
      function teleVe() { return isProgramTele() && resource.data.get('tv', false) == true; }
      allow read: if involved() || upline() || teleVe() || teleDistDe(resource.data) || liderDe(resource.data);
      allow create: if isMember() && request.resource.data.teleId == request.auth.uid
         && request.resource.data.dir == (socioDoc().get('tipo', '') != 'Socio distribuidor' && socioDoc().get('upline', '') == '')
         && request.resource.data.get('up', '') == socioDoc().get('upline', '');
      // Cambios normales: no se toca a quién pertenece la cita.
      // Transferencia: la hace el socio dueño, su distribuidor o Dirección; la privacidad se recalcula para el nuevo socio.
      allow update: if ((involved() || upline())
         && request.resource.data.teleId == resource.data.teleId
         && ((request.resource.data.socioId == resource.data.socioId
              && request.resource.data.dir == resource.data.dir
              && request.resource.data.get('up', '') == resource.data.get('up', '')
              && (request.resource.data.get('tv', false) == resource.data.get('tv', false) || !('tv' in resource.data)))
          || (request.resource.data.socioId != resource.data.socioId
              && (resource.data.socioId == request.auth.uid || upline() || isAdmin())
              && request.resource.data.dir == (socioDoc().get('tipo', '') != 'Socio distribuidor' && socioDoc().get('upline', '') == '')
              && request.resource.data.get('up', '') == socioDoc().get('upline', ''))))
         // Separar Dirección: un director pasa a ver las citas de sus emprendedores (up = su grupo)
         || (isAdmin() && resource.data.get('up', '') == ''
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'dir'])
             && request.resource.data.up == request.auth.uid
             && socioDoc().get('upline', '') == request.auth.uid
             && request.resource.data.dir == false)
         // La líder corrige los datos del cliente y escribe en las citas de sus telemarketers
         || (liderDe(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client', 'phone', 'city', 'address', 'notes', 'chat', 'seen', 'resNote']))
         // Corregir tv (territorio de Dirección) cuando quedó mal: solo se acepta el valor correcto según el socio de la cita
         || ((involved() || upline() || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tv'])
             && request.resource.data.tv == tvDe(resource.data.socioId))
         // Las telemarketers del programa pueden escribir en el chat de esas citas
         || ((teleVe() || teleDistDe(resource.data)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat', 'seen', 'resNote']));
      allow delete: if isAdmin() || (signedIn() && resource.data.teleId == request.auth.uid) || liderDe(resource.data);
    }

    // Registro diario de llamadas: cada persona escribe solo el suyo (id = fecha_uid)
    match /calllog/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
         && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$')
         && request.resource.data.teleId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Enlace al Drive de cada socio: solo lo ven el socio dueño y las telemarketers
    match /drives/{socioId} {
      allow read: if signedIn() && (request.auth.uid == socioId || myRole() == 'tele');
      allow write: if signedIn() && request.auth.uid == socioId
         && request.resource.data.url is string
         && request.resource.data.url.matches('^https://(drive|docs)[.]google[.]com/.*');
    }

    // ===== Ruleta / caja sorpresa (programa de referidos) =====
    // Territorio de un socio: tv = Dirección (lo trabajan las telemarketers del programa)
    function tvDe(sid) {
      let s = get(memberPath(sid)).data;
      return s.role == 'admin' || (s.get('tipo', '') != 'Socio distribuidor'
        && (s.get('upline', '') == '' || get(memberPath(s.upline)).data.role == 'admin'));
    }
    function juegoPath(code) { return /databases/$(database)/documents/juegos/$(code); }
    function leadPath(id) { return /databases/$(database)/documents/leads/$(id); }

    // Programas: regalos, fotos y probabilidades. Los ve cualquiera que abra un link (no tienen datos de clientes).
    match /programs/{pid} {
      allow get: if true;
      allow list: if isMember();
      allow create: if isMember() && request.resource.data.owner == request.auth.uid;
      allow update: if isMember() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if isMember() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Links: público solo el nombre que se muestra y el contador de amigas
    match /juegos/{code} {
      function lv() { return isMember() && (resource.data.by == request.auth.uid || resource.data.socioId == request.auth.uid
        || resource.data.get('up', '') == request.auth.uid || (isProgramTele() && resource.data.get('tv', false) == true) || teleDistDe(resource.data)); }
      allow get: if true;
      allow list: if lv();
      // Un socio o telemarketer inscribe a un cliente o crea una campaña
      allow create: if isMember() && request.resource.data.by == request.auth.uid
         && request.resource.data.n == 0 && request.resource.data.kind in ['cliente', 'campana']
         && request.resource.data.up == get(memberPath(request.resource.data.socioId)).data.get('upline', '')
         && request.resource.data.tv == tvDe(request.resource.data.socioId)
         && request.resource.data.until <= request.time.toMillis() + 61 * 86400000;
      // La amiga que ya participó invita a las suyas: su link copia el de quien la invitó
      allow create: if request.resource.data.kind == 'amiga' && request.resource.data.n == 0
         && request.resource.data.keys().hasOnly(['pid', 'ref', 'socioId', 'up', 'tv', 'by', 'n', 'until', 'padre', 'refLead', 'createdAt', 'kind', 'meta'])
         && request.resource.data.ref is string && request.resource.data.ref.size() <= 61
         && request.resource.data.refLead.matches('^' + request.resource.data.padre + '_[0-9]{10}$')
         && exists(leadPath(request.resource.data.refLead))
         && get(juegoPath(request.resource.data.padre)).data.pid == request.resource.data.pid
         && get(juegoPath(request.resource.data.padre)).data.socioId == request.resource.data.socioId
         && get(juegoPath(request.resource.data.padre)).data.get('up', '') == request.resource.data.up
         && get(juegoPath(request.resource.data.padre)).data.get('tv', false) == request.resource.data.tv
         && get(juegoPath(request.resource.data.padre)).data.by == request.resource.data.by
         && request.resource.data.until <= request.time.toMillis() + 15 * 86400000;
      // Cada amiga que participa suma 1, junto con su registro
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'last'])
         && request.resource.data.n == resource.data.get('n', 0) + 1
         && request.resource.data.last.matches('^' + code + '_[0-9]{10}$')
         && existsAfter(leadPath(request.resource.data.last)) && !exists(leadPath(request.resource.data.last));
      allow update: if lv() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['until', 'ref', 'visitas', 'ganados', 'avisados']);
      allow delete: if isMember() && (resource.data.by == request.auth.uid || resource.data.socioId == request.auth.uid);
    }

    // Prospectos de la ruleta: los ven el socio, quien creó el link, su director o distribuidor
    // y, en el territorio de Dirección, las telemarketers del programa.
    match /leads/{id} {
      function lv() { return signedIn() && (resource.data.socioId == request.auth.uid || resource.data.by == request.auth.uid
        || resource.data.get('up', '') == request.auth.uid || (isProgramTele() && resource.data.get('tv', false) == true) || teleDistDe(resource.data)); }
      allow read: if lv();
      // La amiga que juega (sin cuenta): teléfono completo de 10 dígitos, un registro por número y por link
      allow create: if request.resource.data.keys().hasOnly(['code', 'pid', 'name', 'tel', 'prize', 'at', 'socioId', 'up', 'tv', 'by', 'ref', 'status', 'kind', 'acepta'])
         && request.resource.data.kind == 'jugador' && request.resource.data.status == 'nuevo' && request.resource.data.acepta == true
         && request.resource.data.tel is string && request.resource.data.tel.matches('^[2-9][0-9]{9}$')
         && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
         && request.resource.data.prize is string && request.resource.data.prize.size() <= 80
         && id == request.resource.data.code + '_' + request.resource.data.tel
         && get(juegoPath(request.resource.data.code)).data.pid == request.resource.data.pid
         && get(juegoPath(request.resource.data.code)).data.socioId == request.resource.data.socioId
         && get(juegoPath(request.resource.data.code)).data.get('up', '') == request.resource.data.up
         && get(juegoPath(request.resource.data.code)).data.get('tv', false) == request.resource.data.tv
         && get(juegoPath(request.resource.data.code)).data.by == request.resource.data.by
         && get(juegoPath(request.resource.data.code)).data.ref == request.resource.data.ref
         && get(juegoPath(request.resource.data.code)).data.until > request.time.toMillis()
         && getAfter(juegoPath(request.resource.data.code)).data.n == get(juegoPath(request.resource.data.code)).data.get('n', 0) + 1;
      // El cliente que refiere (o la lista de una campaña): lo guarda quien crea el link
      allow create: if isMember() && request.resource.data.by == request.auth.uid && request.resource.data.kind == 'ref'
         && id == request.resource.data.code + '_ref'
         && getAfter(juegoPath(request.resource.data.code)).data.by == request.auth.uid;
      allow update: if lv() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'notes', 'apptId', 'lista']);
      allow delete: if lv() && (resource.data.by == request.auth.uid || resource.data.socioId == request.auth.uid || isAdmin());
    }

    match /config/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
